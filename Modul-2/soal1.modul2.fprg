    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nilaiakhir" type="Integer" array="False" size=""/>
            <output expression="&quot;masukkan nilai akhir&quot;" newline="True"/>
            <input variable="nilaiakhir"/>
            <if expression="nilaiakhir % 2 == 0">
                <then>
                    <output expression="&quot;genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;ganjil&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
